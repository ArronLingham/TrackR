    <script>
      // The animated background is decorative. Skip it when the CDN is blocked
      // or the viewer has asked for reduced motion, rather than throwing and
      // taking the rest of the page's scripts down with it.
      (function () {
        var reduceMotion =
          window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduceMotion || typeof VANTA === "undefined" || !VANTA.TOPOLOGY) return;
        VANTA.TOPOLOGY({
          el: "#vanta-bg",
          mouseControls: true,
          touchControls: true,
          gyroControls: false,
          minHeight: 200.0,
          minWidth: 200.0,
          scale: 1.0,
          scaleMobile: 1.0,
          color: 0xcaba5c,
          backgroundColor: 0x0,
        });
      })();
    </script>
